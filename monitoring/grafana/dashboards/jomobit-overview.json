      "targets": [
        {
          "expr": "{job=~\"jomobit-app-file-logs|docker-containers|jomobit-deployment-history\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Live Logs",
      "type": "logs"
    }
