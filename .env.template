# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://jomo.amritesh.dev
ALLOWED_ORIGINS=https://jomo.amritesh.dev,https://api.amritesh.dev
LOG_LEVEL=info

# ==========================================
# AWS Configuration
# ==========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1

# ==========================================
# Database & Cache
# ==========================================
MONGODB_URI=mongodb://admin:password@localhost:27017/jomo?authSource=admin
REDIS_URL=redis://localhost:6379

# ==========================================
# Authentication (Auth0)
# ==========================================
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.amritesh.dev
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_WEBHOOK_SECRET=your_auth0_webhook_secret
AUTH0_ACTIONS_SECRET=your_auth0_actions_secret

# ==========================================
# Payments & Subscriptions (Razorpay)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
DEFAULT_USER_CREDITS=3
SUBSCRIPTION_RECONCILIATION_ENABLED=true

# ==========================================
# AI Providers
# ==========================================
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
IDEOGRAM_API_KEY=your_ideogram_api_key
FAL_KEY=your_fal_key

# ==========================================
# Storage & CDN (ImageKit)
# ==========================================
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# ==========================================
# External Webhooks (n8n & Slack)
# ==========================================
SLACK_WEBHOOK_URL=your_slack_webhook_url
N8N_WEBHOOK_URL=your_n8n_webhook_url
N8N_JWT_SECRET=your_n8n_jwt_secret
N8N_REQUEST_KEY=your_n8n_request_key
N8N_GENERATION_FLOW_ID=your_n8n_gen_flow_id
N8N_ENHANCEMENT_FLOW_ID=your_n8n_enhancement_flow_id
